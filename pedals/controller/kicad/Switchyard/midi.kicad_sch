	(global_label "LOOP_RX"
		(shape output)
		(at 116.84 86.36 0)
		(fields_autoplaced yes)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "7c3627db-1a4e-4477-9df0-d4137617a7b8")
		(property "Intersheetrefs" "${INTERSHEET_REFS}"
			(at 116.84 86.36 0)
			(effects (font (size 1.27 1.27)) (justify left) (hide yes))
		)
	)
	(text "The end of the loop: the last pedal's MIDI out plugs in here.\nType A wiring: Tip = MIDI pin 5, Ring = MIDI pin 4, Sleeve = shield.\nThe sleeve is left unconnected on the input, as the MIDI spec asks, to avoid ground loops.\nD3 protects the optocoupler if a reversed (Type B) cable is plugged in."
		(exclude_from_sim no)
		(at 22.86 101.6 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "2751f644-6779-495e-8f73-4ed1bf173100")
	)
	(global_label "LOOP_TX"
		(shape input)
		(at 86.36 137.16 180)
		(fields_autoplaced yes)
		(effects (font (size 1.27 1.27)) (justify right))
		(uuid "e1b3d812-f01f-416b-abfc-6eec59457615")
		(property "Intersheetrefs" "${INTERSHEET_REFS}"
			(at 86.36 137.16 0)
			(effects (font (size 1.27 1.27)) (justify right) (hide yes))
		)
	)
	(text "The start of the loop: plugs into the first pedal's MIDI in.\n3.3V MIDI output, MIDI Association values: 33 ohm from +3.3V to\nthe Ring, 10 ohm from the UART to the Tip.  Sleeve grounded."
		(exclude_from_sim no)
		(at 22.86 154.94 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "9609e4f5-3067-4849-8d70-3a82c740ac5a")
	)
	(global_label "OTHER_TX"
		(shape input)
		(at 220.98 137.16 180)
		(fields_autoplaced yes)
		(effects (font (size 1.27 1.27)) (justify right))
		(uuid "dfad20d5-206a-4b01-90da-e25cce10fdbc")
		(property "Intersheetrefs" "${INTERSHEET_REFS}"
			(at 220.98 137.16 0)
			(effects (font (size 1.27 1.27)) (justify right) (hide yes))
		)
	)
	(text "Outside the loop: program changes for other brands' MIDI pedals\n(through their thru jacks or a splitter).  Same circuit as the\nloop out, on UART1, so it never carries loop traffic."
		(exclude_from_sim no)
		(at 157.48 154.94 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "c9e2316d-08d5-43c5-b5cd-617e4012a793")
	)
	(text "Switchyard sends on LOOP_TX and hears the whole loop back on LOOP_RX:\nevery Linework pedal passes on what it receives and adds its own messages\n(Linework Control Specification).  A gap in the loop shows up as missing\nActive Sensing, which is how the app finds a broken cable or a dead pedal."
		(exclude_from_sim no)
		(at 157.48 58.42 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "d740fbec-e7b5-4fd2-93f8-6a95ffae9569")
	)
