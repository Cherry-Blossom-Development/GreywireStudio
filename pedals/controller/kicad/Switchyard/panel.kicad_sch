	(text "Soft-touch momentary footswitches on the\nlid, each wired to a 2-pin JST PH connector.\nPressing is the only action: holding does\nnothing extra.  The firmware debounces them;\nthe 100n capacitors filter noise picked up\non the switch wires."
		(exclude_from_sim no)
		(at 22.86 121.92 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "5572efba-82ed-4572-9fba-0932da5a7e84")
	)
