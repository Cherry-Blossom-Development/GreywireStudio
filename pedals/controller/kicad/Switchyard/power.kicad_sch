	(text "D: 5V POWER SELECT"
		(exclude_from_sim no)
		(at 82.55 108.585 0)
		(effects (font (size 1.524 1.524) (bold yes)) (justify left))
		(uuid "f8fd0516-ec80-4bbf-8d08-3582577cfe4f")
	)
	(text "Center-negative 2.1 mm jack, as on every pedal.\nD1 protects against a reversed adapter.\nThe breadboard uses a 1N5817 (same part, leaded)."
		(exclude_from_sim no)
		(at 22.86 91.44 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "78ff794b-63ed-4d6e-a327-a968899dd9a5")
	)
	(global_label "5V_BUCK"
		(shape output)
		(at 177.8 66.04 0)
		(fields_autoplaced yes)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "febfb93e-e47f-428d-a446-ec54d66cae09")
		(property "Intersheetrefs" "${INTERSHEET_REFS}"
			(at 177.8 66.04 0)
			(effects (font (size 1.27 1.27)) (justify left) (hide yes))
		)
	)
	(text "U3: 9V to 5V switching converter, about 85% efficient.\nUp to about 0.6 A: 0.5 A for the phone's keep-alive charge\nplus about 0.1 A for Switchyard. A linear regulator would\nturn about 2.4 W into heat here, so a switcher is needed.\nL1 and C1, C2, C4, C6 are the datasheet's values for 5V.\nKeep U3, L1 and the capacitors close together."
		(exclude_from_sim no)
		(at 83.82 93.98 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "7776fe48-875a-4165-9fbc-be8608856c11")
	)
	(global_label "5V_BUCK"
		(shape input)
		(at 208.28 60.96 90)
		(fields_autoplaced yes)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "6e58ff77-735f-45dd-b39a-cba46770ef27")
		(property "Intersheetrefs" "${INTERSHEET_REFS}"
			(at 208.28 60.96 0)
			(effects (font (size 1.27 1.27)) (justify left) (hide yes))
		)
	)
	(global_label "SENSE_9V"
		(shape output)
		(at 215.9 72.39 0)
		(fields_autoplaced yes)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "d90b6996-8699-449c-92ef-da5c30de0af3")
		(property "Intersheetrefs" "${INTERSHEET_REFS}"
			(at 215.9 72.39 0)
			(effects (font (size 1.27 1.27)) (justify left) (hide yes))
		)
	)
	(text "About 3V on SENSE_9V (GPIO26, ADC0)\nwhen the 9V supply is plugged in,\n0V when Switchyard runs from the phone."
		(exclude_from_sim no)
		(at 190.5 88.9 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "bf9cf5bf-a7b6-4966-91c6-d261457f9d3a")
	)
	(global_label "5V_BUCK"
		(shape input)
		(at 132.08 119.38 180)
