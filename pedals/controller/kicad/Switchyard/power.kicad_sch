		(property "Intersheetrefs" "${INTERSHEET_REFS}"
			(at 132.08 132.08 0)
			(effects (font (size 1.27 1.27)) (justify right) (hide yes))
		)
	)
	(text "+5V (about 4.6V after the diodes) comes from whichever is there:\nthe 9V supply through U3, or the phone through USB.\nThe diodes stop either one feeding back into the other.\n+5V only feeds the 3.3V regulator (Controller sheet)."
		(exclude_from_sim no)
		(at 83.82 139.7 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "beba5e5f-1765-4bd6-929a-153f697e78f8")
	)
