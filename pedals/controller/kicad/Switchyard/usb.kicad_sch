	(text "U7 handles USB-C's power rules (I2C address 0x22, shares the display's bus).\nIt starts as a power sink, even with no power at all, so the phone powers Switchyard\nwhen there's no 9V.  With 9V present the firmware asks the phone for a power role\nswap: the phone keeps running the data, and Switchyard then supplies VBUS through U8.\nVCONN (for powered cables) isn't used: the firmware never turns its switch on.\nPD_INT is open-drain (R16 pull-up)."
		(exclude_from_sim no)
		(at 134.62 119.38 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "09df7332-5f0c-4152-b3ba-6f9b3c68e6a4")
	)
	(global_label "5V_BUCK"
		(shape input)
		(at 60.96 157.48 180)
		(fields_autoplaced yes)
		(effects (font (size 1.27 1.27)) (justify right))
		(uuid "e829e037-61e9-494e-87a4-a3f21344a932")
		(property "Intersheetrefs" "${INTERSHEET_REFS}"
			(at 60.96 157.48 0)
			(effects (font (size 1.27 1.27)) (justify right) (hide yes))
		)
	)
	(global_label "VBUS_EN"
		(shape input)
		(at 60.96 162.56 180)
		(fields_autoplaced yes)
		(effects (font (size 1.27 1.27)) (justify right))
		(uuid "4cc1e421-4d3e-4ed4-bb46-fc45f7c5e446")
		(property "Intersheetrefs" "${INTERSHEET_REFS}"
			(at 60.96 162.56 0)
			(effects (font (size 1.27 1.27)) (justify right) (hide yes))
		)
	)
	(global_label "VBUS"
		(shape output)
		(at 106.68 157.48 0)
		(fields_autoplaced yes)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "5b328dbf-df5e-4a54-bb26-fbe43bae6ecb")
		(property "Intersheetrefs" "${INTERSHEET_REFS}"
			(at 106.68 157.48 0)
			(effects (font (size 1.27 1.27)) (justify left) (hide yes))
		)
	)
	(global_label "VBUS_FLT"
		(shape output)
		(at 114.3 162.56 0)
		(fields_autoplaced yes)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "6395d63d-5138-44d9-baf9-113e348ae0e8")
		(property "Intersheetrefs" "${INTERSHEET_REFS}"
			(at 114.3 162.56 0)
			(effects (font (size 1.27 1.27)) (justify left) (hide yes))
		)
	)
	(text "U8 passes 5V to the phone only when VBUS_EN is high (R17 holds it off\nuntil the firmware starts), limits the current, and blocks the phone's\nown 5V from flowing back.  VBUS_FLT goes low on overcurrent.\nKeep-alive charge: 5V at 0.5 A, about 2.5 W."
		(exclude_from_sim no)
		(at 22.86 190.5 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "398601d1-8e7c-4419-8963-5047ab625989")
	)
