	(text "The phone is the USB host: it runs the data, and Switchyard\nis a USB MIDI device.  U9 protects the data lines and VBUS\nfrom static.  R14 and R15 are the RP2040's 27 ohm data resistors.\nR13 and C9 tie the shield to ground without a hum path.\nSBU1 and SBU2 aren't used."
		(exclude_from_sim no)
		(at 71.12 109.22 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "c63b901c-8ab8-42f1-9184-6cdd2ccd8f46")
	)
	(global_label "SDA"
		(shape bidirectional)
		(at 157.48 93.98 180)
		(fields_autoplaced yes)
		(effects (font (size 1.27 1.27)) (justify right))
		(uuid "cf844342-6093-4ac4-817b-4657049d83e3")
		(property "Intersheetrefs" "${INTERSHEET_REFS}"
			(at 157.48 93.98 0)
			(effects (font (size 1.27 1.27)) (justify right) (hide yes))
		)
	)
	(global_label "SCL"
		(shape input)
		(at 157.48 96.52 180)
		(fields_autoplaced yes)
		(effects (font (size 1.27 1.27)) (justify right))
