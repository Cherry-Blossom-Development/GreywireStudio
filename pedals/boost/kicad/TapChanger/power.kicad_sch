	)
	(text "D3 protects against a reversed adapter.\nThe breadboard uses a 1N5817 (same part, leaded)."
		(exclude_from_sim no)
		(at 22.86 91.44 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "6a7bbadb-d023-4d92-898c-393418020f1e")
	)
	(text "U1B buffers VB.  It drives VB directly, with no series resistor,\nbecause the Boost stage's R4 and C3 return\nthe audio to VB: a resistor here would change the gain."
		(exclude_from_sim no)
		(at 83.82 91.44 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "9dadf9d7-68cc-4618-9927-5b6f1f31add4")
	)
	(text "+5V: bypass relay, LED driver, 3.3V regulator.\nAbout 100 mA at most: about 0.4 W in U3."
		(exclude_from_sim no)
		(at 22.86 140.97 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "827d7b0f-6db7-4402-a3f5-8c6e03c2b54c")
	)
	(text "U1 = OPA1678 dual op-amp:\nU1A Boost stage (Audio sheet), U1B VB buffer (above)"
		(exclude_from_sim no)
		(at 91.44 146.05 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "dfa582d9-dab9-4bbc-8081-bfddac8c4e6b")
	)
