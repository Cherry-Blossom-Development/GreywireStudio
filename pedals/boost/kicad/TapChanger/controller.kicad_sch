	(text "GPIO plan (no-connect = spare)\nSame numbers as Flashover,\nso the firmware carries over.\n\nGPIO0       MIDI out (UART0 TX)\nGPIO1       MIDI in (UART0 RX)\nGPIO2       Spare (Flashover's Soft/Hard)\nGPIO3       FX_ON: bypass relay\nGPIO4-5    SDA, SCL: digital pot (I2C0)\nGPIO6-8    Boost encoder A, B, push\nGPIO9-14  Spare\nGPIO15     FOOTSW: footswitch\nGPIO16     Spare\nGPIO17     LED_EN: LED driver on/off\nGPIO18-19 LED_SDA, LED_SCL (I2C1)\nGPIO20     LINK_LED\nGPIO21-29 Spare"
		(exclude_from_sim no)
		(at 223.52 35.56 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "9ceca848-71fd-44bf-b82c-67b661b4d56e")
	)
	(text "USB is not used (Tap Changer has no USB port).\nFirmware updates arrive over MIDI."
		(exclude_from_sim no)
		(at 165.1 158.75 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "0f40f802-65d3-4513-8642-327c7cf9916b")
	)
	(text "2 MB: two firmware copies,\nsettings and 128 presets"
		(exclude_from_sim no)
		(at 63.5 127 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "bd29fa51-b458-490a-b5fa-2f78e43aa6c0")
	)
