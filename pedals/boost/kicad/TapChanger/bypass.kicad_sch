	(text "Relay off = BYPASS: the input jack\nconnects straight to the output jack\nthrough both NC contacts (BYPASS).\nWith no power the relay is off, so a\ndead pedal still passes the guitar.\nRelay on = effect: input -> FX_IN,\nFX_OUT -> output.  R28 keeps it in\nbypass until the firmware starts."
		(exclude_from_sim no)
		(at 22.86 99.06 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "2751f644-6779-495e-8f73-4ed1bf173100")
	)
	(text "To avoid clicks, the firmware\nturns Boost down for a few ms\nwhile the relay switches."
		(exclude_from_sim no)
		(at 137.16 81.28 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "e1b3d812-f01f-416b-abfc-6eec59457615")
	)
