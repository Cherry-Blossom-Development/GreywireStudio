	(text "FLASHOVER"
		(exclude_from_sim no)
		(at 40.64 38.1 0)
		(effects (font (size 3 3) (bold yes)) (justify left))
		(uuid "c91e3374-4931-41ba-a0aa-25f19511f63f")
	)
	(text "Distortion / overdrive pedal, Linework series.  Main board, version 0.1.\nBased on GS1 (MXR Distortion+) with Soft/Hard clipping, a DS-1 style Tone control,\na x4 output amplifier and digital pots for Gain, Tone and Level.\nValues match the LTspice model in pedals/distortion/sim/Flashover_circuit.inc."
		(exclude_from_sim no)
		(at 40.64 45.72 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "f4e0a029-086b-4b29-b86d-191010dd7eda")
	)
	(text "Signal flow:  input jack (Bypass)  ->  Input and Gain  ->  Clipping  ->  Tone and Output  ->  output jack (Bypass)"
		(exclude_from_sim no)
		(at 30.48 86.36 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "2797a1ee-1549-4b03-a16a-cace70199e65")
	)
	(text "Two boards in a 1590BB enclosure.  This main board holds the audio circuit, controller,\ndigital pots, MIDI, bypass and all five jacks (along the top edge).  The knobs, LED rings,\nSoft/Hard button and panel LEDs are on the control board (project Flashover_Controls),\nwhich plugs into J7 on the Board Connector sheet."
		(exclude_from_sim no)
		(at 93.98 137.16 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "407e3e66-83f3-4dd5-a395-909096aed613")
	)
	(text "Footprints: surface-mount for assembly, through-hole for jacks, encoders, panel LEDs,\nthe Soft/Hard button, the regulator (laid flat) and the germanium diodes.\nAudio-path capacitors (C1-C5, C8, C9, C12) must be C0G or film, not X7R."
		(exclude_from_sim no)
		(at 30.48 167.64 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "534461cd-79f3-4882-af44-d878b1ddfd57")
	)
