	)
	(text "Distortion / overdrive pedal, Linework series. Audio path, controller, controls and MIDI, version 0.1.\nBased on GS1 (MXR Distortion+) with Soft/Hard clipping, a DS-1 style Tone control,\na x4 output amplifier and digital pots for Gain, Tone and Level.\nValues match the LTspice model in pedals/distortion/sim/Flashover_circuit.inc."
		(exclude_from_sim no)
		(at 40.64 45.72 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "da697b00-f138-48bc-a287-7d68678ef269")
	)
	(text "Signal flow:  Input and Gain  ->  Clipping  ->  Tone and Output"
		(exclude_from_sim no)
		(at 116.84 86.36 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "2e1d772e-dd4a-4daf-bc39-43153fee272e")
	)
	(text "The controller sheets connect to the audio sheets and the controls through global labels\n(HARD_SEL, SDA/SCL, encoder, LED and MIDI signals) and the +3V3 / +5V power symbols."
		(exclude_from_sim no)
		(at 40.64 165.1 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "01bceeb7-dde1-4fa1-a09c-9b29bc0d94bd")
	)
	(text "Still to be drawn: bypass relay, footswitch and Link LED."
		(exclude_from_sim no)
		(at 40.64 172.72 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "52bc16c9-63c9-4703-89bc-7ffa3acf1c33")
