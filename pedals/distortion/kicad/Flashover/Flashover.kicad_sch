	(text "FLASHOVER"
		(exclude_from_sim no)
		(at 40.64 38.1 0)
		(effects (font (size 3 3) (bold yes)) (justify left))
		(uuid "6f5e403b-ef7c-4aa2-be9c-6a25b6a6b6f6")
	)
	(text "Distortion / overdrive pedal, Linework series. Complete schematic, version 0.1.\nBased on GS1 (MXR Distortion+) with Soft/Hard clipping, a DS-1 style Tone control,\na x4 output amplifier and digital pots for Gain, Tone and Level.\nValues match the LTspice model in pedals/distortion/sim/Flashover_circuit.inc."
		(exclude_from_sim no)
		(at 40.64 45.72 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "3699cd97-1ee5-4f73-bb47-126f2291e643")
	)
	(text "Signal flow:  input jack (Bypass)  ->  Input and Gain  ->  Clipping  ->  Tone and Output  ->  output jack (Bypass)"
		(exclude_from_sim no)
		(at 30.48 86.36 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "f1278b14-20cc-4756-8419-60b56a6bd8f4")
	)
	(text "The controller sheets connect to the audio sheets and the controls through global labels\n(FX_IN/FX_OUT, HARD_SEL, SDA/SCL, encoder, LED, MIDI and bypass signals) and the power symbols."
		(exclude_from_sim no)
		(at 30.48 165.1 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "a7552566-36e7-4819-8d35-31065f10a047")
	)
	(text "Footprints assigned: surface-mount for assembly, through-hole for jacks, encoders, panel LEDs,\nthe Soft/Hard button, the TO-220 regulator and the germanium diodes.\nAudio-path capacitors (C1-C5, C8, C9, C12) must be C0G or film, not X7R."
		(exclude_from_sim no)
		(at 30.48 172.72 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "6c5fc011-bd75-4dfa-b1cc-989e8c40884a")
	)
