	(global_label "MIDI_RX"
		(shape output)
		(at 116.84 86.36 0)
		(fields_autoplaced yes)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "83752977-5ba0-46d8-a607-3b622e56bc95")
		(property "Intersheetrefs" "${INTERSHEET_REFS}"
			(at 116.84 86.36 0)
			(effects (font (size 1.27 1.27)) (justify left) (hide yes))
		)
	)
	(text "Type A wiring: Tip = MIDI pin 5, Ring = MIDI pin 4, Sleeve = shield.\nThe sleeve is left unconnected on the input, as the MIDI spec asks, to avoid ground loops.\nD43 protects the optocoupler if a reversed (Type B) cable is plugged in.\nThe H11L1 runs from 3.3V and its output idles high, as the UART expects."
		(exclude_from_sim no)
		(at 22.86 101.6 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "0ea527e6-5915-4edd-b5a2-0d4d23d6d469")
	)
	(global_label "MIDI_TX"
		(shape input)
		(at 86.36 137.16 180)
		(fields_autoplaced yes)
		(effects (font (size 1.27 1.27)) (justify right))
		(uuid "0b589846-32ac-4b13-bf91-6b62c57f05a2")
		(property "Intersheetrefs" "${INTERSHEET_REFS}"
			(at 86.36 137.16 0)
			(effects (font (size 1.27 1.27)) (justify right) (hide yes))
		)
	)
	(text "3.3V MIDI output, using the values in the MIDI Association's 3.3V update:\n33 ohm from +3.3V to pin 4 (Ring) and 10 ohm from the UART to pin 5 (Tip).\nThe sleeve is grounded on the output."
		(exclude_from_sim no)
		(at 22.86 154.94 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "2b96903f-6804-4abd-94aa-f8efcef5087c")
	)
	(text "No hardware MIDI thru.  The firmware passes on every message it receives\nand adds its own (merging, per the Linework Control Specification).\nIf the pedal loses power the loop stops here; Switchyard detects the break.\n\nMIDI_RX and MIDI_TX go to UART0 on the microcontroller (GPIO1 and GPIO0)."
		(exclude_from_sim no)
		(at 157.48 58.42 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "e321288a-7ca0-4b6b-a5cb-acd43488dab5")
	)
