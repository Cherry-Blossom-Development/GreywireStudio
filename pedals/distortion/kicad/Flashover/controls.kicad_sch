	(text "Each press toggles Soft / Hard.\nThe LEDs showing the mode are on the LED Rings sheet."
		(exclude_from_sim no)
		(at 22.86 147.32 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "ce6eaeaa-d3f7-43d5-9698-cb69abdafcfc")
	)
	(text "Encoders: Bourns PEC11R type, 24 steps per turn with a push switch\n(shaft length to suit the enclosure).  No end stops: the LED ring shows the setting.\nA and B have 10k pull-ups and 10n caps (0.1 ms) to smooth contact bounce;\nthe push switches are debounced in firmware.\nAll signals go to the microcontroller on the Controller sheet."
		(exclude_from_sim no)
		(at 111.76 119.38 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "2b3cb31d-0967-4aef-b0b9-87ba12d73210")
	)
