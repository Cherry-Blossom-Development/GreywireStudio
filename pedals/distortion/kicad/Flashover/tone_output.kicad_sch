	(text "Gain = 1 + R16 / R17 = 4 (+12 dB), makes up the tone network's loss"
		(exclude_from_sim no)
		(at 69.85 119.38 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "8a2d7ee0-f73a-4cdf-852d-5847f6e34211")
	)
	(text "U8A (Tone) and U9A (Level) are MCP45HV51 digital pots (10k);\ntheir control and power pins are on the Digital Pots sheet.\nEverything after the gain stage is centered on VB (4.5V)\nso the digital pots only see 0V to 9V.\nLevel is reduced to about 38% in Hard mode to match Soft's volume."
		(exclude_from_sim no)
		(at 20.32 134.62 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "5b57d010-7932-464b-8b3e-2606f22a0509")
	)
