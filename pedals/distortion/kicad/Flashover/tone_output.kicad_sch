	(text "RV2 (Tone) and RV3 (Level) are MCP41HV digital pots.\nEverything after the gain stage is centered on VB (4.5V)\nso the digital pots only see 0V to 9V.\nLevel is reduced to about 38% in Hard mode to match Soft's volume."
		(exclude_from_sim no)
		(at 20.32 134.62 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "8cfabc9c-d775-4c50-a2cc-b2e7dff4f407")
	)
