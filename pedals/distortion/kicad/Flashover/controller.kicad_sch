	(text "+5V comes from U3 on the Power sheet.\n+3V3 feeds the microcontroller, flash\nand the digital pots' logic side."
		(exclude_from_sim no)
		(at 22.86 71.12 0)
		(effects (font (size 1 1)) (justify left))
