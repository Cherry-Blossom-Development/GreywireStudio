	)
	(text "3.3V: C16 on VREG_VIN, one 100n at each of the six IOVDD pins, USB_VDD, ADC_AVDD.   1.1V: C25 on VREG_VOUT, 100n at each DVDD pin."
		(exclude_from_sim no)
		(at 111.76 50.8 0)
