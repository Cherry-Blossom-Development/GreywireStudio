	(text "GPIO plan (no-connect = sheet not drawn yet)\nGPIO0       MIDI out (UART0 TX)\nGPIO1       MIDI in (UART0 RX)\nGPIO2       HARD_SEL: Soft/Hard relay\nGPIO3       Bypass relay\nGPIO4-5    SDA, SCL: digital pots (I2C0)\nGPIO6-8    Gain encoder A, B, push\nGPIO9-11  Tone encoder A, B, push\nGPIO12-14 Level encoder A, B, push\nGPIO15     Footswitch\nGPIO16     Soft/Hard button\nGPIO17     LED_EN: LED driver on/off\nGPIO18-19 LED_SDA, LED_SCL (I2C1)\nGPIO20     Link LED\nGPIO21-29 Spare"
		(exclude_from_sim no)
		(at 223.52 35.56 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "0c8c6ea9-c90d-4ef9-a3da-3228fb189b41")
	)
