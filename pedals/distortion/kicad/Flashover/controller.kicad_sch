	(text "GPIO plan (not drawn yet = no-connect for now)\nGPIO0   MIDI out (UART0 TX)\nGPIO1   MIDI in (UART0 RX)\nGPIO2   HARD_SEL - Soft/Hard relay   [drawn]\nGPIO3   Bypass relay\nGPIO4   SDA - digital pots, LED ring driver   [drawn]\nGPIO5   SCL   [drawn]\nGPIO6-8     Gain encoder A, B, push\nGPIO9-11   Tone encoder A, B, push\nGPIO12-14 Level encoder A, B, push\nGPIO15  Footswitch\nGPIO16  Soft/Hard button\nGPIO17-20 Soft, Hard, On, Link LEDs\nGPIO21-29 Spare"
		(exclude_from_sim no)
		(at 190.5 91.44 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "76be171e-19b6-4d73-85d2-e974ac6cd92e")
	)
