	(text "Relay off = BYPASS: the input jack\nconnects straight to the output jack\nthrough both NC contacts (BYPASS).\nWith no power the relay is off, so a\ndead pedal still passes the guitar.\nRelay on = effect: input -> FX_IN,\nFX_OUT -> output.  R44 keeps it in\nbypass until the firmware starts."
		(exclude_from_sim no)
		(at 22.86 99.06 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "bd9f525a-c257-4591-9d88-558d9668fcad")
	)
	(text "To avoid clicks, the firmware\nturns Level down for a few ms\nwhile the relay switches."
		(exclude_from_sim no)
		(at 137.16 81.28 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "ef1f946b-8526-4001-901f-815fa6cafd4a")
	)
