	(lib_symbols
	)
	(text "FLASHOVER BREAKOUT BOARD"
		(exclude_from_sim no)
		(at 40.64 38.1 0)
		(effects (font (size 3 3) (bold yes)) (justify left))
		(uuid "5ae7d71c-efb2-4e01-8fdc-dd2b5ec74eab")
	)
	(text "For the breadboard prototype (stages 2-5).  The three MCP45HV51 digital pots and the IS31FL3236A\nLED driver from the Flashover main board, which only come in tiny surface-mount packages, on a\nsmall 2-layer board that JLCPCB assembles.  Two rows of 30 pins, 17.78 mm (0.7\") apart like a\nRaspberry Pi Pico, so it straddles a breadboard's centre gap."
		(exclude_from_sim no)
		(at 40.64 45.72 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "48a7ddf6-b8fe-4d60-93e8-1a4242b2177f")
	)
	(text "Same chips, addresses, supporting parts and references as the main board, so the firmware runs\nunchanged.  The LED driver here is the QFN-44 package (the main board has the TQFP-48 one)."
		(exclude_from_sim no)
		(at 40.64 99.06 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "a40722cc-0e2e-455b-9b93-958dc05e2282")
	)
