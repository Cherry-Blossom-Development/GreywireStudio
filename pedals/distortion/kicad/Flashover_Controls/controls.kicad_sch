	(text "Each press toggles Soft / Hard.\nThe LEDs showing the mode are on the LED Rings sheet."
		(exclude_from_sim no)
		(at 22.86 147.32 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "ac0a7de5-5533-413b-8519-124a55b63918")
	)
	(text "Encoders: Bourns PEC11R type, 24 steps per turn with a push switch\n(shaft length to suit the enclosure).  No end stops: the LED ring shows the setting.\nA and B have 10k pull-ups and 10n caps (0.1 ms) to smooth contact bounce;\nthe push switches are debounced in firmware.\nAll signals go to the microcontroller on the main board through J8."
		(exclude_from_sim no)
		(at 111.76 119.38 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "fbcdbaa9-0153-471f-8d5b-8af402424ea7")
	)
